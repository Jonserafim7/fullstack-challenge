            },
            "description": "Direct wallets service health check, bypassing Kong."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Planned - Game API",
      "description": "Endpoints listed in README.md but not fully implemented yet. Keep these as contract placeholders while building the game service.",
      "item": [
        {
          "name": "Get current round",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kongUrl}}/games/rounds/current",
              "host": [
                "{{kongUrl}}"
              ],
              "path": [
