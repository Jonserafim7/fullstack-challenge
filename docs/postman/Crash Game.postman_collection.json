{
  "info": {
    "_postman_id": "9b9a8c9d-0df5-4ef3-9bfb-5f4d47ec4382",
    "name": "Crash Game",
    "description": "Postman collection for the Crash Game challenge. Run `bun run docker:up`, then call `Auth / Get player access token` before authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get player access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"token request succeeded\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloakClientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{playerUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{playerPassword}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/crash-game/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "crash-game",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Gets a JWT for the default Keycloak test user and stores it in the collection variable `accessToken`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Implemented - Gateway",
      "item": [
        {
          "name": "Games health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kongUrl}}/games/health",
              "host": [
                "{{kongUrl}}"
              ],
              "path": [
                "games",
                "health"
              ]
            },
            "description": "Health check routed through Kong to the games service."
          },
          "response": []
        },
        {
          "name": "Wallets health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kongUrl}}/wallets/health",
              "host": [
                "{{kongUrl}}"
              ],
              "path": [
                "wallets",
                "health"
              ]
            },
            "description": "Health check routed through Kong to the wallets service."
          },
          "response": []
        },
        {
          "name": "Create my wallet",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{kongUrl}}/wallets",
              "host": [
                "{{kongUrl}}"
              ],
              "path": [
                "wallets"
              ]
            },
            "description": "Creates the authenticated player's wallet. This is idempotent: 201 when created, 200 when it already exists."
          },
          "response": []
        },
        {
          "name": "Get my wallet",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kongUrl}}/wallets/me",
              "host": [
                "{{kongUrl}}"
              ],
              "path": [
                "wallets",
                "me"
              ]
            },
            "description": "Returns the authenticated player's wallet and balance in integer cents."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Implemented - Direct Services",
      "item": [
        {
          "name": "Games health - direct",
          "request": {
            "method": "GET",
            "header": [],
