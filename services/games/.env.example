# Values for running the service locally (outside Docker).
# Inside Docker these are provided by docker-compose.yml.
PORT=4001
DATABASE_URL=postgresql://admin:admin@localhost:5432/games
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# Provably-fair engine (ADR-0002).
HOUSE_EDGE=0.01
CLIENT_SEED=crash-game
SERVER_CHAIN_LENGTH=100000
# A fixed 64-hex terminal seed makes the Commitment and Crash Point sequence
# reproducible across restarts. Leave unset for a random chain per process.
# SERVER_TERMINAL_SEED=

# Round timing (milliseconds). Running length always varies with the Crash Point.
BETTING_DURATION_MS=5000
CRASHED_DISPLAY_MS=3000
