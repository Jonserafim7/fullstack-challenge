# Values for running the service locally (outside Docker).
# Inside Docker these are provided by docker-compose.yml.
PORT=4002
DATABASE_URL=postgresql://admin:admin@localhost:5432/wallets
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# Outbox relay (ADR-0008): drain interval, and the publish attempts before a row is left alone.
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=10

# Auth: validate the token issuer, fetch signing keys from the IdP.
KEYCLOAK_ISSUER=http://localhost:8080/realms/crash-game
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/crash-game/protocol/openid-connect/certs

# Seed: the test players' stable subjects (match docker/keycloak/realm-export.json)
# and the balance their Wallets start with, in integer cents. The second player exists so
# the live multiplayer presence (#9) can be demoed with two distinct usernames.
TEST_PLAYER_ID=11111111-1111-1111-1111-111111111111
TEST_PLAYER_ID_2=22222222-2222-2222-2222-222222222222
WALLET_STARTING_BALANCE_CENTS=100000
