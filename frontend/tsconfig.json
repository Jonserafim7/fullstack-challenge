{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "node"],
    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@crash/crash-curve": ["../packages/crash-curve/src/index.ts"],
      "@crash/provably-fair": ["../packages/provably-fair/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  // Test files import bun:test (a Bun runtime module) and run under `bun test`, not tsc;
  // exclude them from the typecheck so tsc does not flag the bun:test import.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
